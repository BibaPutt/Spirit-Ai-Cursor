{
  "name": "spirit-deep",
  "version": "2.0.0-alpha.0",
  "description": "Spirit Deep — AI-aware cursor companion",
  "private": true,
  "license": "BUSL-1.1",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dist": "npm run build && electron-builder --mac --win --linux",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run dist:mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run dist:mac && npm run dist:win && npm run dist:linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed --exclude tests/latexMath.test.ts --pool=forks",
    "gate:fast": "npm run typecheck && npm run test:changed",
    "gate": "npm run typecheck && vitest run --exclude tests/latexMath.test.ts --pool=forks && npm run build",
    "postinstall": "electron-builder install-app-deps && node scripts/install-stt.js",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:typecheck": "npm --prefix site run typecheck",
    "site:preview": "npm --prefix site run preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@openuidev/lang-core": "^1.0.2",
    "@openuidev/react-headless": "^0.18.1",
    "@openuidev/react-lang": "^1.0.2",
    "@openuidev/react-ui": "^0.18.1",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tabler/icons-react": "^3.46.0",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "franc-min": "^6.2.0",
    "i18next": "^26.3.6",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.3",
    "mermaid": "^11.16.1",
    "msedge-tts": "^2.0.7",
    "node-gyp-build": "^4.8.4",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uiohook-napi": "^1.5.4",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^4.1.6",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "framer-motion": "^11.0.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.0",
    "unified": "^11.0.5",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.6",
    "vitest": "^4.1.6"
  }
}
